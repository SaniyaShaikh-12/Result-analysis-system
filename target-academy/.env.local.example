# ─── MONGODB ATLAS ───────────────────────────────────────────────
# Get this from mongodb.com/atlas → Connect → Drivers
MONGODB_URI=your_mongodb_uri


# ─── JWT SECRET ──────────────────────────────────────────────────
# Any long random string — keep it secret
JWT_SECRET=target_academy_super_secret_key_change_this_2024

# ─── ACADEMY EMAIL (Gmail) ───────────────────────────────────────
# The Gmail you created for the academy
EMAIL_USER=targetacademy.results@gmail.com
# App Password from Google Account → Security → App Passwords
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Target Coaching Academy <targetacademy.results@gmail.com>

# ─── APP URL ─────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
